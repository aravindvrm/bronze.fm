{
  "name": "bronze-fm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "dev:tailscale": "vite --host $(tailscale ip -4 | head -1)",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:usb": "PWA_DEV=true vite --host 127.0.0.1",
    "cover": "node scripts/encode-cover.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
