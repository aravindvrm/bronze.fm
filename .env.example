# Public — safe to ship in the client bundle. Guarded by RLS.
VITE_SUPABASE_URL=https://daqljfmurwdsxkfgfrgs.supabase.co
VITE_SUPABASE_ANON_KEY=

# Default Creator when the URL carries no tenant hint (bare root on a shared
# host). VITE_ARTIST_SLUG/VITE_RELEASE_SLUG existed here previously but were
# never actually read anywhere — this is the one the resolver consumes.
VITE_DEFAULT_CREATOR=robotrebel

# Content source: "fixtures" (local, no network) or "supabase"
VITE_CONTENT_SOURCE=fixtures

# NOTE: SUPABASE_SERVICE_ROLE_KEY belongs in .env only, never prefixed with
# VITE_ — anything VITE_-prefixed is inlined into the public bundle.

# Domain that Creator subdomains hang off (robotrebel.bronze.fm).
VITE_APP_DOMAIN=bronze.fm

# --- Vercel Edge Middleware only — NOT read by Vite, NOT needed locally ---
# SITE_PASSCODE gates the entire deployment (middleware.ts) behind a shared
# passcode. `npm run dev` never executes middleware.ts — only a real Vercel
# deployment does — so this has no effect in local development and does not
# belong in this file's .env counterpart. Set it in the Vercel dashboard only:
# Project Settings → Environment Variables → SITE_PASSCODE (no VITE_ prefix —
# that prefix means "inline this into the public bundle", the opposite of
# what a gate secret needs). Unset, the gate fails closed and locks everyone
# out, including you — see middleware.ts.
#
# SITE_PASSCODE=choose-a-real-phrase-here
