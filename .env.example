# Public — safe to ship in the client bundle. Guarded by RLS.
VITE_SUPABASE_URL=https://daqljfmurwdsxkfgfrgs.supabase.co
VITE_SUPABASE_ANON_KEY=

# Default Creator when the URL carries no tenant hint — a bare root on a
# shared host. Consumed by the resolver in src/lib/tenant.ts.
VITE_DEFAULT_CREATOR=deanMaye

# Content source: "fixtures" (local, no network) or "supabase"
VITE_CONTENT_SOURCE=fixtures

# NOTE: SUPABASE_SERVICE_ROLE_KEY belongs in .env only, never prefixed with
# VITE_ — anything VITE_-prefixed is inlined into the public bundle.

# Domain that Creator subdomains hang off (dean.bronze.fm).
VITE_APP_DOMAIN=bronze.fm
